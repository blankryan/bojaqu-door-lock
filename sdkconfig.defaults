# Bojaqu Smart Door-Lock — Shared Base Configuration (ESP-IDF v6.1.0)
# Merged first by CMakePresets.json before configs/dev/sdkconfig or configs/prod/sdkconfig.
# Reference ADRs: ADR-0002 (Hardware/PSRAM), ADR-0006 (OTA/16MB Partitions), ADR-0007 (Presets/Security)

# Target & Clock
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# Flash (16 MB on ESP32-S3-WROOM-1-N16R8)
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 8 MB Octal PSRAM (ESP32-S3-WROOM-1-N16R8; reserves GPIO33-GPIO37)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Custom 16 MB Dual-OTA Partition Table (shared 0x10000 offset across dev & prod)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000

# OTA Automatic Rollback (confirmed after post-boot self-test)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# TLS / Cryptography
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Watchdog Supervision
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
