{
    "version": 3,
    "configurePresets": [
        {
            "name": "dev",
            "binaryDir": "./build-outputs/dev",
            "displayName": "dev",
            "description": "Development configuration for bench testing and Wokwi simulation of bojaqu-door-lock",
            "cacheVariables": {
                "SDKCONFIG_DEFAULTS": "sdkconfig.defaults;configs/dev/sdkconfig",
                "SDKCONFIG": "./build-outputs/dev/sdkconfig"
            }
        },
        {
            "name": "prod",
            "binaryDir": "./build-outputs/prod",
            "displayName": "prod",
            "description": "Production configuration for bojaqu-door-lock (Secure Boot v2, Flash/NVS Encryption, Anti-Rollback)",
            "cacheVariables": {
                "SDKCONFIG_DEFAULTS": "sdkconfig.defaults;configs/prod/sdkconfig",
                "SDKCONFIG": "./build-outputs/prod/sdkconfig"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "dev",
            "configurePreset": "dev",
            "displayName": "Build dev"
        },
        {
            "name": "prod",
            "configurePreset": "prod",
            "displayName": "Build prod"
        }
    ]
}
