# Bojaqu Smart Door-Lock — Development Preset Overlay (CMakePresets: "dev")
# Safe for bench ESP32-S3 devkits and Wokwi simulation (no irreversible eFuse burns).
# Reference: ADR-0005, ADR-0007

# Flash & PSRAM Tolerance (DIO + ignore-not-found keeps Wokwi / non-PSRAM devkits bootable)
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Compiler & Diagnostics
CONFIG_COMPILER_OPTIMIZATION_DEBUG=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
# CONFIG_ESP_TASK_WDT_PANIC is not set

# Hardware Security Disabled in dev (Reversible USB-JTAG / UART0 Flashing)
# CONFIG_SECURE_BOOT is not set
# CONFIG_SECURE_FLASH_ENC_ENABLED is not set
# CONFIG_NVS_ENCRYPTION is not set
# CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK is not set
CONFIG_SECURE_ROM_DL_MODE_ENABLED=y

# Application-level Kconfig overrides (activate once main/Kconfig.projbuild is added):
# CONFIG_BJQ_RFID_ALLOW_UID_FALLBACK=y
# CONFIG_BJQ_ENV_STAGING=y
